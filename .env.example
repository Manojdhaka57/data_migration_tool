# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------- SOURCE DB ---
# The database being migrated FROM.
SOURCE_DB_TYPE='mysql'          # mysql | postgresql
SOURCE_DB_HOST='localhost'
SOURCE_DB_PORT='3306'
SOURCE_DB_NAME='source_db'
SOURCE_DB_USER='root'
SOURCE_DB_PASSWORD=''
SOURCE_DB_SSL=false

# ---------------------------------------------------------------- TARGET DB ---
# The database being migrated TO.
TARGET_DB_TYPE='postgresql'     # mysql | postgresql
TARGET_DB_HOST='localhost'
TARGET_DB_PORT='5432'
TARGET_DB_NAME='target_db'
TARGET_DB_USER='postgres'
TARGET_DB_PASSWORD=''
TARGET_DB_SSL=false

# Any of the above can be left out and supplied from the Connection tab in the
# UI instead; a value entered there overrides the one here.

# ------------------------------------------------------------------- REDIS ---
# Required — the migration queue and durable table state live here.
REDIS_HOST='127.0.0.1'
REDIS_PORT='6379'

# ------------------------------------------------------- METADATA DATABASE ---
# OPTIONAL. A third database holding the tool's OWN state: saved migration
# configurations and their version history, the connection registry, users and
# run history. Everything else works without it.
#
# Setup:
#   createdb erp_migration_meta
#   npm run appdb:up
#   npm run appdb:createuser -- --username admin --role admin
APP_DB_HOST='localhost'
APP_DB_PORT='5432'
APP_DB_NAME='erp_migration_meta'
APP_DB_USER='postgres'
APP_DB_PASSWORD=''
APP_DB_SSL=false

# ---------------------------------------------------------------- SECURITY ---
# Encrypts connection passwords stored in the metadata database.
# Generate with:  openssl rand -base64 32
APP_SECRET_KEY=''

# Enforce login on the API. Leave false until the login UI ships — turning it on
# without it will lock the browser app out of its own API.
AUTH_ENABLED=false

# Encrypts column values mapped with the `encrypt` flag. Must match the
# application's PII key or migrated ciphertext will not decrypt downstream.
# Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=''

# ---------------------------------------------------------------- OPTIONAL ---
# Full path to pg_dump if it is not on PATH (fixes ENOENT on Schema DDL).
# PG_DUMP_PATH='/usr/local/bin/pg_dump'

# =====================================================================
# DEPLOYMENT (Vercel frontend + Render backend)
# Everything above is enough to run locally; this section is only needed
# when hosting.
# =====================================================================

# ---------------------------------------------------------------- FRONTEND ---
# Baked into the JS bundle at build time and readable by anyone who loads the
# page. NEVER put a secret in a VITE_* variable.
#   local:  VITE_API_URL=http://localhost:9005
#   Vercel: VITE_API_URL=https://<your-api>.onrender.com
# Accepted with or without a trailing /api. VITE_API_BASE_URL still works.
VITE_API_URL='http://localhost:9005'

# --------------------------------------------------------------------- CORS ---
# Comma-separated browser origins allowed to call the API and the websocket.
# Leave UNSET locally — that allows any origin, which is the dev behaviour.
# In production set it: a wildcard origin is refused by browsers once bearer
# tokens are involved.
# FRONTEND_URL='https://<your-app>.vercel.app'

# --------------------------------------------------------------------- PORT ---
# Render assigns this at runtime — do NOT set it there. Local default is 9005.
# PORT='9005'

# -------------------------------------------------------------------- REDIS ---
# REDIS_URL takes precedence over REDIS_HOST/REDIS_PORT above and is what a
# managed provider gives you, because it carries the password. A rediss:// URL
# enables TLS.
# REDIS_URL='rediss://red-xxxx:password@oregon-keyvalue.render.com:6379'

# ------------------------------------------------------------------ WORKERS ---
# Set false on the API service when the BullMQ workers run as a separate
# Render Background Worker (npm run start:worker). Default true keeps the
# single-process behaviour.
# RUN_WORKER_IN_PROCESS='false'
# WORKER_CONCURRENCY='2'

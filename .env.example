# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------- SOURCE DB ---
# The database being migrated FROM.
SOURCE_DB_TYPE='mysql'          # mysql | postgresql
SOURCE_DB_HOST='localhost'
SOURCE_DB_PORT='3306'
SOURCE_DB_NAME='source_db'
SOURCE_DB_USER='root'
SOURCE_DB_PASSWORD=''
SOURCE_DB_SSL=false

# ---------------------------------------------------------------- TARGET DB ---
# The database being migrated TO.
TARGET_DB_TYPE='postgresql'     # mysql | postgresql
TARGET_DB_HOST='localhost'
TARGET_DB_PORT='5432'
TARGET_DB_NAME='target_db'
TARGET_DB_USER='postgres'
TARGET_DB_PASSWORD=''
TARGET_DB_SSL=false

# Any of the above can be left out and supplied from the Connection tab in the
# UI instead; a value entered there overrides the one here.

# ------------------------------------------------------------------- REDIS ---
# Required — the migration queue and durable table state live here.
REDIS_HOST='127.0.0.1'
REDIS_PORT='6379'

# ------------------------------------------------------- METADATA DATABASE ---
# OPTIONAL. A third database holding the tool's OWN state: saved migration
# configurations and their version history, the connection registry, users and
# run history. Everything else works without it.
#
# Setup:
#   createdb erp_migration_meta
#   npm run appdb:up
#   npm run appdb:createuser -- --username admin --role admin
APP_DB_HOST='localhost'
APP_DB_PORT='5432'
APP_DB_NAME='erp_migration_meta'
APP_DB_USER='postgres'
APP_DB_PASSWORD=''
APP_DB_SSL=false

# ---------------------------------------------------------------- SECURITY ---
# Encrypts connection passwords stored in the metadata database.
# Generate with:  openssl rand -base64 32
APP_SECRET_KEY=''

# Enforce login on the API. Leave false until the login UI ships — turning it on
# without it will lock the browser app out of its own API.
AUTH_ENABLED=false

# Encrypts column values mapped with the `encrypt` flag. Must match the
# application's PII key or migrated ciphertext will not decrypt downstream.
# Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=''

# ---------------------------------------------------------------- OPTIONAL ---
# Full path to pg_dump if it is not on PATH (fixes ENOENT on Schema DDL).
# PG_DUMP_PATH='/usr/local/bin/pg_dump'

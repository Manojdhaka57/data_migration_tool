{
  "name": "erp_data_migration",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:scripts": "tsc -p tsconfig.scripts-check.json",
    "appdb:create": "npx tsx scripts/metadata/cli/migrate.ts create",
    "appdb:up": "npx tsx scripts/metadata/cli/migrate.ts up",
    "appdb:down": "npx tsx scripts/metadata/cli/migrate.ts down",
    "appdb:status": "npx tsx scripts/metadata/cli/migrate.ts status",
    "appdb:createuser": "npx tsx scripts/metadata/cli/createUser.ts",
    "preview": "vite preview",
    "migrate": "npx tsx scripts/test-mysql-connection.ts",
    "migrate:dry-run": "npx tsx scripts/migrate-db.ts --dry-run",
    "migrate:server": "npx tsx scripts/migration-server.ts",
    "migrate:server:mysql": "npx tsx scripts/migration-server-mysql.ts",
    "sync:data": "npx tsx scripts/sync-data.ts",
    "sync:data:dry-run": "npx tsx scripts/sync-data.ts --dry-run",
    "appdb:seedusers": "npx tsx scripts/metadata/cli/seedUsers.ts",
    "appdb:import-local": "npx tsx scripts/metadata/cli/importLocalData.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/poppins": "^5.2.7",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/uuid": "^10.0.0",
    "bullmq": "^5.77.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0",
    "pg-query-stream": "^4.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.17.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
